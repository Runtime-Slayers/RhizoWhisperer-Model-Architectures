\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Loss component decomposition.} BCE+Dice (epochs 1--5) contribute the largest absolute reduction ($0.8520 \to 0.2339$). clDice (epochs 6--10) provides the next step ($0.2339 \to 0.1027$). PIET-Loss delivers the final refinement ($0.0784 \to 0.0412$), confirming its role in physics-consistent predictions.}}{25}{figure.caption.28}\protected@file@percent }
\newlabel{fig:loss_decomposition}{{24}{25}{\textbf {Loss component decomposition.} BCE+Dice (epochs 1--5) contribute the largest absolute reduction ($0.8520 \to 0.2339$). clDice (epochs 6--10) provides the next step ($0.2339 \to 0.1027$). PIET-Loss delivers the final refinement ($0.0784 \to 0.0412$), confirming its role in physics-consistent predictions}{figure.caption.28}{}}

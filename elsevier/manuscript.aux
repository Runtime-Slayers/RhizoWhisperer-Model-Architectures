\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {CARRS drought resilience simulation.} DRI trajectories under RCP~4.5 (green, moderate warming $+2.0^{\circ }$C by 2100) and RCP~8.5 (red, severe warming $+4.5^{\circ }$C). Under RCP~4.5, DRI remains above the critical threshold (0.40) throughout the growing season. Under RCP~8.5, DRI drops below 0.40 at approximately day~85, indicating critical drought stress onset.}}{21}{figure.caption.19}\protected@file@percent }
\newlabel{fig:carrs}{{17}{21}{\textbf {CARRS drought resilience simulation.} DRI trajectories under RCP~4.5 (green, moderate warming $+2.0^{\circ }$C by 2100) and RCP~8.5 (red, severe warming $+4.5^{\circ }$C). Under RCP~4.5, DRI remains above the critical threshold (0.40) throughout the growing season. Under RCP~8.5, DRI drops below 0.40 at approximately day~85, indicating critical drought stress onset}{figure.caption.19}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {20-epoch deep curriculum loss convergence.} Vertical dashed lines mark curriculum boundaries. Final composite loss converges to 0.0412, representing a 95.2\% reduction from epoch-1 loss (0.8520). clDice (epochs 6--10) provides the most dramatic improvement in centreline connectivity.}}{24}{figure.caption.25}\protected@file@percent }
\newlabel{fig:loss_curve}{{21}{24}{\textbf {20-epoch deep curriculum loss convergence.} Vertical dashed lines mark curriculum boundaries. Final composite loss converges to 0.0412, representing a 95.2\% reduction from epoch-1 loss (0.8520). clDice (epochs 6--10) provides the most dramatic improvement in centreline connectivity}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {ONNX deployment profile.} Model size versus CPU inference latency. RhizoHybridTransformer (1.17~MB, 1.8~ms) occupies the desirable lower-left corner. Horizontal dashed line at 10~ms marks the real-time threshold for typical agricultural drone frame rates (100~FPS).}}{24}{figure.caption.26}\protected@file@percent }
\newlabel{fig:onnx_profile}{{22}{24}{\textbf {ONNX deployment profile.} Model size versus CPU inference latency. RhizoHybridTransformer (1.17~MB, 1.8~ms) occupies the desirable lower-left corner. Horizontal dashed line at 10~ms marks the real-time threshold for typical agricultural drone frame rates (100~FPS)}{figure.caption.26}{}}
